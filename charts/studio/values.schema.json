{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Rasa Studio Helm Chart Values",
  "description": "Schema for validating Rasa Studio Helm chart values",
  "definitions": {
    "secretRef": {
      "description": "Reference to a Kubernetes Secret key",
      "type": "object",
      "required": ["secretName", "secretKey"],
      "properties": {
        "secretName": {
          "description": "Name of the Kubernetes Secret",
          "type": "string",
          "minLength": 1
        },
        "secretKey": {
          "description": "Key within the Kubernetes Secret",
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "secretRefOrString": {
      "description": "Plain string value or a reference to a Kubernetes Secret key",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/definitions/secretRef"
        }
      ]
    },
    "envVar": {
      "description": "Kubernetes-native container environment variable",
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "description": "Environment variable name",
          "type": "string",
          "minLength": 1
        },
        "value": {
          "description": "Literal value. Scalars (boolean/number) are accepted and rendered as quoted strings — Kubernetes requires EnvVar values to be strings.",
          "type": ["string", "number", "boolean"]
        },
        "valueFrom": {
          "description": "Source for the value (secretKeyRef, configMapKeyRef, fieldRef, resourceFieldRef)",
          "type": "object",
          "minProperties": 1
        }
      },
      "not": {
        "required": ["value", "valueFrom"]
      },
      "additionalProperties": false
    },
    "imageConfig": {
      "description": "Container image configuration",
      "type": "object",
      "properties": {
        "name": {
          "description": "Container image name",
          "type": "string"
        },
        "pullPolicy": {
          "description": "Image pull policy",
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "resourceRequirements": {
      "description": "Kubernetes resource limits and requests",
      "type": "object",
      "properties": {
        "limits": {
          "type": "object"
        },
        "requests": {
          "type": "object"
        }
      }
    },
    "autoscaling": {
      "description": "Horizontal Pod Autoscaler configuration",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "targetMemoryUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "serviceConfig": {
      "description": "Kubernetes Service configuration",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "targetPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "ingressConfig": {
      "description": "Kubernetes Ingress configuration",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "labels": {
          "type": "object"
        },
        "additionalAnnotations": {
          "type": "object"
        },
        "tls": {
          "type": "array"
        }
      }
    },
    "serviceAccount": {
      "description": "Kubernetes ServiceAccount configuration",
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "schedulingConfig": {
      "description": "Pod scheduling configuration (nodeSelector, affinity, tolerations)",
      "type": "object",
      "properties": {
        "nodeSelector": {
          "type": "object"
        },
        "affinity": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        }
      }
    }
  },
  "type": "object",
  "required": ["config"],
  "properties": {
    "nameOverride": {
      "description": "Override name of app",
      "type": "string"
    },
    "fullnameOverride": {
      "description": "Override the full qualified app name",
      "type": "string"
    },
    "imagePullSecrets": {
      "description": "Image pull secrets for private registries",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" }
        }
      }
    },
    "repository": {
      "description": "Image repository for all Studio components",
      "type": "string"
    },
    "tag": {
      "description": "Image tag for all Studio components",
      "type": "string"
    },
    "config": {
      "description": "Global configuration shared across all Studio components",
      "type": "object",
      "required": ["database"],
      "properties": {
        "connectionType": {
          "description": "URL scheme (http or https) for externally derived URLs; does not change in-cluster service-to-service calls",
          "type": "string",
          "enum": ["http", "https"]
        },
        "database": {
          "description": "PostgreSQL database connection settings shared by all components",
          "type": "object",
          "required": ["host"],
          "properties": {
            "host": {
              "description": "Database host name or IP address",
              "type": "string",
              "minLength": 1
            },
            "port": {
              "description": "Database port (default: 5432)",
              "type": "string"
            },
            "username": {
              "description": "Database username — plain string or secret reference",
              "$ref": "#/definitions/secretRefOrString"
            },
            "password": {
              "description": "Database password — always a secret reference",
              "$ref": "#/definitions/secretRef"
            },
            "databaseName": {
              "description": "Database name for Studio app — plain string or secret reference",
              "$ref": "#/definitions/secretRefOrString"
            },
            "queryParams": {
              "description": "Additional database connection URL query parameters",
              "type": "string"
            },
            "preferSSL": {
              "description": "Enable SSL for database connections",
              "type": "string"
            },
            "rejectUnauthorized": {
              "description": "Reject database connections with untrusted certificates",
              "type": "string"
            },
            "useAwsIamAuth": {
              "description": "Use AWS IAM authentication instead of password",
              "type": "string"
            },
            "awsRegion": {
              "description": "AWS region for IAM database authentication",
              "type": "string"
            },
            "iamDbUsername": {
              "description": "IAM database username for AWS RDS IAM authentication",
              "type": "string"
            }
          }
        },
        "nodeSelector": {
          "description": "Global node selector applied to all deployments",
          "type": "object"
        },
        "affinity": {
          "description": "Global affinity rules applied to all deployments",
          "type": "object"
        },
        "tolerations": {
          "description": "Global tolerations applied to all deployments",
          "type": "array"
        }
      }
    },
    "app": {
      "description": "Studio App component configuration",
      "type": "object",
      "properties": {
        "replicaCount": {
          "description": "Number of app replicas",
          "type": "integer",
          "minimum": 1
        },
        "authSecret": {
          "description": "Secret used by the app to sign sessions and tokens (min 32 chars) — secret reference. Required.",
          "$ref": "#/definitions/secretRef"
        },
        "env": {
          "description": "Extra environment variables for the Studio App container (native EnvVar list)",
          "type": "array",
          "items": { "$ref": "#/definitions/envVar" }
        },
        "migration": {
          "description": "Database migration hook Job configuration",
          "type": "object",
          "properties": {
            "env": {
              "description": "Extra environment variables for the migration Job container (native EnvVar list)",
              "type": "array",
              "items": { "$ref": "#/definitions/envVar" }
            },
            "backoffLimit": {
              "description": "Job backoffLimit — retries before the migration Job is marked failed",
              "type": "integer",
              "minimum": 0
            },
            "activeDeadlineSeconds": {
              "description": "Job activeDeadlineSeconds — hard wall-clock bound for the migration Job",
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "image": {
          "$ref": "#/definitions/imageConfig"
        },
        "autoscaling": {
          "$ref": "#/definitions/autoscaling"
        },
        "service": {
          "$ref": "#/definitions/serviceConfig"
        },
        "ingress": {
          "$ref": "#/definitions/ingressConfig"
        },
        "serviceAccount": {
          "$ref": "#/definitions/serviceAccount"
        },
        "resources": {
          "$ref": "#/definitions/resourceRequirements"
        },
        "nodeSelector": {
          "type": "object"
        },
        "affinity": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "webClient": {
          "description": "Browser runtime configuration for the unified Studio app (config.js mounted on the app pod)",
          "type": "object",
          "properties": {
            "config": {
              "description": "Plain scalar map rendered into config.js as window.* globals",
              "type": "object",
              "additionalProperties": {
                "type": ["string", "number", "boolean"]
              }
            }
          },
          "additionalProperties": false
        }
      }
    },
    "eventIngestion": {
      "description": "Studio Event Ingestion component configuration",
      "type": "object",
      "properties": {
        "mode": {
          "description": "Where to run event ingestion",
          "type": "string",
          "enum": ["colocated", "separate", "disabled"]
        },
        "env": {
          "description": "Extra environment variables (native EnvVar list)",
          "type": "array",
          "items": { "$ref": "#/definitions/envVar" }
        },
        "replicaCount": {
          "description": "Number of event ingestion replicas",
          "type": "integer",
          "minimum": 1
        },
        "image": {
          "$ref": "#/definitions/imageConfig"
        },
        "autoscaling": {
          "$ref": "#/definitions/autoscaling"
        },
        "service": {
          "$ref": "#/definitions/serviceConfig"
        },
        "serviceAccount": {
          "$ref": "#/definitions/serviceAccount"
        },
        "resources": {
          "$ref": "#/definitions/resourceRequirements"
        },
        "nodeSelector": {
          "type": "object"
        },
        "affinity": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        }
      }
    },
    "networkPolicy": {
      "description": "Kubernetes NetworkPolicy configuration",
      "type": "object",
      "properties": {
        "enabled": {
          "description": "Enable NetworkPolicy resources. Requires a CNI that enforces NetworkPolicy (e.g. Calico, Cilium).",
          "type": "boolean"
        },
        "denyAll": {
          "description": "Create a default-deny policy for all ingress and egress traffic",
          "type": "boolean"
        }
      }
    },
    "global": {
      "description": "Global values passed to subcharts",
      "type": "object",
      "properties": {
        "ingressHost": {
          "description": "Single-host knob: one hostname for the Studio app and Rasa Pro model-service ingresses and all derived URLs. Leave unset for split-host installs.",
          "type": ["string", "null"]
        },
        "ingressClassName": {
          "description": "Ingress class for the Studio app and Rasa Pro model-service ingresses. Fallback: a per-ingress className wins when set.",
          "type": ["string", "null"]
        },
        "ingressAnnotations": {
          "description": "Annotations added to the Studio app and Rasa Pro model-service ingresses. Merged with per-ingress annotations, which win on key conflicts.",
          "type": ["object", "null"]
        }
      }
    },
    "hostNetwork": {
      "description": "Allow pods to use the node network namespace",
      "type": "boolean"
    },
    "dnsPolicy": {
      "description": "Pod DNS policy override",
      "type": "string"
    },
    "dnsConfig": {
      "description": "Pod DNS config override",
      "type": "object"
    },
    "deploymentAnnotations": {
      "description": "Annotations applied to all Studio Deployment resources",
      "type": "object"
    },
    "deploymentLabels": {
      "description": "Labels applied to all Studio Deployment resources",
      "type": "object"
    },
    "podLabels": {
      "description": "Labels applied to all Studio pods",
      "type": "object"
    },
    "rasa": {
      "description": "Rasa Pro subchart configuration. See charts/rasa/values.yaml for all available options.",
      "type": "object",
      "properties": {
        "enabled": {
          "description": "Deploy the bundled Rasa Pro model server. Set false to use an external instance.",
          "type": "boolean"
        }
      }
    }
  }
}
